# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# one-shot DB purge backups (large, content-only — keep local)
scripts/backup-ai-drafts-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Stage 0 security: credentials and runtime artifacts must never be committed
server/workers/telegram-session*.txt
*.session
server/**/*.log

# Local operational scripts that embed credentials (keep out of git)
scripts/verify-key-rotation.mjs
scripts/check-live-bundle.mjs
